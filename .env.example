# .env.example — QuantEdge MT5: Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to git — it contains secrets.
#
# HOW TO USE:
#   Copy-Item .env.example .env
#   Then edit .env with your actual MT5 credentials.

# ===========================================================================
# MetaTrader 5 Connection
# ===========================================================================
MT5_LOGIN=your_login_here
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ===========================================================================
# Optional: Override default paths
# ===========================================================================
# BASE_DIR=D:\Trading
# LOG_DIR=D:\Trading\logs
# MODEL_DIR=D:\Trading\models

# ===========================================================================
# Optional: Model Path for ML Inference
# ===========================================================================
# MODEL_PATH=models/EURUSD_random_forest_20260101_120000.joblib